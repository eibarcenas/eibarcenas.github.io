# Copy this file to .env and fill in your values.
# VITE_INSTRUCTOR_PASS_HASH is the SHA-256 hex digest of the instructor password,
# not the plaintext password itself (Vite inlines VITE_ vars into the public bundle,
# so the plaintext must never go here). Generate it with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-password-here').digest('hex'))"
VITE_INSTRUCTOR_PASS_HASH=
